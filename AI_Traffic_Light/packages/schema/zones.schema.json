{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrafficZones",
  "type": "object",
  "required": [
    "zones"
  ],
  "properties": {
    "image_width": {
      "type": "integer"
    },
    "image_height": {
      "type": "integer"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "polygon"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "pedestrian_waiting",
              "crossing",
              "vehicle_queue",
              "ignore"
            ]
          },
          "label": {
            "type": "string"
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}