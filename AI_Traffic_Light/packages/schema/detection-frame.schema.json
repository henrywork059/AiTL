{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DetectionFrame",
  "type": "object",
  "required": [
    "frame_id",
    "source_id",
    "image_width",
    "image_height",
    "timestamp_ms",
    "detections"
  ],
  "properties": {
    "frame_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class_id",
          "class_name",
          "confidence",
          "box_xyxy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class_id": {
            "type": "integer"
          },
          "class_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "box_xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}